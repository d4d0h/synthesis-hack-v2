# === AI Model Providers ===
GROQ_API_KEY=gsk_...                  # groq.com — free tier, primary
ANTHROPIC_API_KEY=sk-ant-...          # optional fallback
VENICE_API_KEY=...                    # optional: venice.ai — no data retention
OPENROUTER_API_KEY=sk-or-...          # optional: free models fallback

# === Ethereum / ERC-8004 ===
AGENT_PRIVATE_KEY=0x...               # agent's wallet private key
PEER_PRIVATE_KEY=0x...                # peer agent wallet (for demo)
CHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
IDENTITY_REGISTRY=0x...               # ERC-8004 Identity Registry address
REPUTATION_REGISTRY=0x...             # ERC-8004 Reputation Registry address

# === Synthesis Hackathon ===
SYNTH_API_KEY=sk-synth-...            # from /register/complete
SYNTH_PARTICIPANT_ID=...
SYNTH_TEAM_ID=...

# === Cloudflare (for deploy) ===
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
